# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
.venv/
venv/
env/

# Packaging / build output (regenerated by build.ps1 or the release workflow)
build/
dist/
*.spec.bak

# Test, lint and type-check caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Runtime data.
# authfile.txt lists the devices authorized on *this* machine and is generated on
# first run - it must never be published. Copy authfile.example.txt if you want a
# commented starting point. Recover a previously committed copy with:
#   git show <commit>:authfile.txt
authfile.txt
authfile.txt.tmp
*.log

# Editors / OS
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.DS_Store
Thumbs.db
desktop.ini
